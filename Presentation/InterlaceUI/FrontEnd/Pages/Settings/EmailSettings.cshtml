@page
@{
    ViewData["Title"] = "Email Settings";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Outgoing mail server (SMTP)</h5>
                    <span class="badge bg-secondary">{{ state.source }}</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8"><label class="form-label">Host</label><input class="form-control" v-model="state.f.host" placeholder="smtp.gmail.com" autocomplete="off" /></div>
                        <div class="col-md-4"><label class="form-label">Port</label><input type="number" class="form-control" v-model.number="state.f.port" /></div>
                        <div class="col-md-4"><label class="form-label">Security</label>
                            <select class="form-select" v-model="state.f.security">
                                <option value="Auto">Automatic</option>
                                <option value="SslOnConnect">SSL (usually port 465)</option>
                                <option value="StartTls">STARTTLS (usually port 587)</option>
                                <option value="None">None (not recommended)</option>
                            </select></div>
                        <div class="col-md-4"><label class="form-label">User name</label><input class="form-control" v-model="state.f.userName" autocomplete="off" /></div>
                        <div class="col-md-4"><label class="form-label">Password</label>
                            <input type="password" class="form-control" v-model="state.f.password" autocomplete="new-password" :placeholder="state.hasPassword ? 'Saved. Leave empty to keep' : ''" /></div>
                        <div class="col-md-6"><label class="form-label">From address</label><input type="email" class="form-control" v-model="state.f.fromAddress" placeholder="sales@yourcompany.com" /></div>
                        <div class="col-md-6"><label class="form-label">From name</label><input class="form-control" v-model="state.f.fromName" placeholder="Your Company" /></div>
                    </div>
                    <div class="form-text mt-2">Gmail and Outlook need an app password, not your normal password. The password is stored encrypted and is never shown again.</div>
                    <div class="mt-3"><button class="btn btn-primary" @@click="save" :disabled="state.busy">Save settings</button></div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">Send a test e-mail</h5></div>
                <div class="card-body">
                    <div class="input-group" style="max-width:480px">
                        <input type="email" class="form-control" v-model="state.testTo" placeholder="you@example.com" />
                        <button class="btn btn-outline-primary" @@click="test" :disabled="state.busy">Send test</button>
                    </div>
                    <div class="form-text">Save first, then test. The result and any server error are shown here.</div>
                    <div class="alert mt-3 mb-0" :class="state.testOk ? 'alert-success' : 'alert-danger'" v-if="state.testMessage">{{ state.testMessage }}</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Settings/EmailSettings.cshtml.js"></script>
}
