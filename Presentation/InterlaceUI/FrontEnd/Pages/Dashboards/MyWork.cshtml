@page
@{
    ViewData["Title"] = "My Work";
}

<div id="app" v-cloak>
    <div class="d-flex align-items-center mb-3">
        <p class="text-muted mb-0 flex-grow-1">Your own records and tasks. Overdue items are marked in red.</p>
        <button class="btn btn-sm btn-outline-primary" @@click="load" :disabled="state.loading">Refresh</button>
    </div>
    <div v-if="state.loading" class="text-muted">Loading...</div>
    <div v-else-if="!state.sections.length" class="alert alert-info">Nothing to show yet. Sections appear for the modules your role can access.</div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3" v-for="s in state.sections" :key="s.key">
            <a :href="s.url" class="card text-decoration-none h-100">
                <div class="card-body">
                    <div class="small text-muted">{{ s.label }}</div>
                    <div style="font-size:1.8rem;font-weight:600;line-height:1.2">{{ s.count }}</div>
                    <div class="small text-muted" v-if="s.amount !== null && s.amount !== undefined">{{ money(s.amount) }}</div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6" v-for="s in withItems" :key="s.key">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between"><h6 class="mb-0">{{ s.label }}</h6><a :href="s.url" class="small">Open</a></div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex gap-2 align-items-center" v-for="i in s.items" :key="i.id">
                        <div class="flex-grow-1">
                            <a :href="i.url">{{ i.title || i.number }}</a>
                            <div class="small text-muted">{{ i.number }}<span v-if="i.sub"> · {{ i.sub }}</span></div>
                        </div>
                        <span class="small" :class="i.overdue ? 'text-danger fw-semibold' : 'text-muted'" v-if="i.when">{{ day(i.when) }}</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Dashboards/MyWork.cshtml.js"></script>
}
