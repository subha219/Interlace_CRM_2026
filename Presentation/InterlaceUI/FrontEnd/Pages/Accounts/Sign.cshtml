@page
@{
    ViewData["Title"] = "Sign document";
}

<div id="app" v-cloak>
    <div class="auth-status" v-if="state.mode === 'loading'"><p class="auth-sub">Loading...</p></div>
    <div class="auth-status" v-else-if="state.mode === 'invalid'">
        <h1 class="auth-title">Link not valid</h1>
        <p class="auth-sub">This signing link is not valid. Please use the link from your e-mail.</p>
    </div>
    <div class="auth-status" v-else-if="state.mode === 'closed'">
        <h1 class="auth-title">{{ state.closedTitle }}</h1>
        <p class="auth-sub">{{ state.closedText }}</p>
    </div>
    <div v-else-if="state.mode === 'signed'" class="auth-status">
        <h1 class="auth-title">Thank you</h1>
        <p class="auth-sub">You have signed this document. A confirmation copy is on its way to your e-mail.</p>
    </div>
    <div v-else-if="state.mode === 'declined'" class="auth-status">
        <h1 class="auth-title">Declined</h1>
        <p class="auth-sub">We have let the sender know.</p>
    </div>
    <div v-else>
        <div class="auth-status">
            <h1 class="auth-title">{{ state.d.title }}</h1>
            <p class="auth-sub">Hello {{ state.d.signerName }}, please read the document and sign below.</p>
        </div>
        <pre class="p-3 border rounded mb-3" style="max-height:260px;overflow:auto;white-space:pre-wrap;font-family:inherit;font-size:13px">{{ state.d.documentText }}</pre>

        <div v-if="!state.codeSent">
            <p class="small">To sign, we send a 6-digit code to <strong>{{ state.d.signerEmailMasked }}</strong>.</p>
            <button class="auth-btn" :disabled="state.busy" @@click="sendCode">{{ state.busy ? 'Please wait...' : 'E-mail me a code' }}</button>
        </div>
        <form v-else v-on:submit.prevent="sign">
            <input class="form-control mb-2" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="6-digit code" v-model="state.code" />
            <input class="form-control mb-2" maxlength="200" placeholder="Type your full name" v-model="state.name" />
            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="ag" v-model="state.agree" /><label class="form-check-label small" for="ag">I have read the document and agree to sign it electronically. Typing my name is my signature.</label></div>
            <button type="submit" class="auth-btn" :disabled="state.busy">{{ state.busy ? 'Please wait...' : 'Sign document' }}</button>
            <div class="mt-2"><a href="#" class="small" @@click.prevent="sendCode">Send the code again</a></div>
        </form>
        <div class="text-danger small mt-2" v-if="state.error">{{ state.error }}</div>
        <div class="mt-3 text-center"><a href="#" class="small text-muted" @@click.prevent="decline">Decline to sign</a></div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Accounts/Sign.cshtml.js"></script>
}
