@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Chat with us</title>
    <style>
        :root { --bg:#fff; --fg:#1f2933; --muted:#6b7785; --line:#dde3ea; --brand:#2563eb; --me:#2563eb; --them:#eef1f5; }
        @@media (prefers-color-scheme: dark) { :root { --bg:#1b2129; --fg:#e6ebf0; --muted:#97a3b0; --line:#323b46; --them:#2a323c; } }
        * { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; }
        body { font: 14px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--bg); color: var(--fg); display: flex; flex-direction: column; }
        header { padding: 12px 14px; background: var(--brand); color: #fff; font-weight: 600; }
        #log { flex: 1; overflow-y: auto; padding: 12px; }
        .row { display: flex; margin-bottom: 8px; }
        .row.me { justify-content: flex-end; }
        .bubble { max-width: 80%; padding: 8px 10px; border-radius: 10px; background: var(--them); white-space: pre-wrap; word-wrap: break-word; }
        .me .bubble { background: var(--me); color: #fff; }
        .who { font-size: 11px; color: var(--muted); margin-bottom: 2px; }
        form { display: flex; gap: 6px; padding: 10px; border-top: 1px solid var(--line); }
        input, textarea, button { font: inherit; }
        input, textarea { flex: 1; padding: 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }
        button { padding: 8px 14px; border: 0; border-radius: 6px; background: var(--brand); color: #fff; cursor: pointer; }
        button:disabled { opacity: .6; cursor: default; }
        #start { padding: 14px; display: flex; flex-direction: column; gap: 8px; }
        #start label { font-size: 12px; color: var(--muted); }
        .note { padding: 8px 12px; font-size: 12px; color: var(--muted); }
        .err { color: #c0392b; padding: 0 12px 6px; font-size: 12px; min-height: 16px; }
        [hidden] { display: none !important; }
    </style>
</head>
<body>
    <header>Chat with us</header>

    <div id="start">
        <div class="note" style="padding:0">Tell us who you are and how we can help. We usually answer within a few minutes.</div>
        <div><label for="n">Your name</label><input id="n" maxlength="100" autocomplete="name" style="width:100%" /></div>
        <div><label for="e">E-mail (optional, so we can follow up)</label><input id="e" type="email" maxlength="255" autocomplete="email" style="width:100%" /></div>
        <div><label for="m">Message</label><textarea id="m" rows="3" maxlength="1000" style="width:100%"></textarea></div>
        <div class="err" id="serr"></div>
        <button id="go" type="button">Start chat</button>
    </div>

    <div id="log" hidden></div>
    <div class="err" id="cerr" hidden></div>
    <form id="form" hidden autocomplete="off">
        <input id="t" maxlength="1000" placeholder="Type your message" />
        <button id="send" type="submit">Send</button>
    </form>
    <div class="note" id="ended" hidden>This chat has ended. Reload to start a new one.</div>

    <script src="~/FrontEnd/Pages/Accounts/ChatWidget.cshtml.js"></script>
</body>
</html>
