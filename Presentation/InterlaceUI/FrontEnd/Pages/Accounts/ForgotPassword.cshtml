@page
@{
    ViewData["Title"] = "Forgot Password";
}

<div id="app" v-cloak>
    <h1 class="auth-title">Reset your password</h1>
    <p class="auth-sub">Enter your email and we will send you a link to choose a new password.</p>

    <form v-on:submit.prevent="handleSubmit" novalidate>
            <div class="auth-field">
                <label for="Email">Email</label>
                <div class="auth-input" :class="{ invalid: state.errors.email }">
                    <i class="lead far fa-envelope"></i>
                    <input id="Email" name="Email" type="email" placeholder="name@company.com" autocomplete="username" v-model="state.email" v-on:input="state.errors.email = ''" />
                    
                </div>
                <p class="auth-error" v-if="state.errors.email">{{ state.errors.email }}</p>
            </div>
            <button type="submit" v-bind:disabled="state.isSubmitting" class="auth-btn">
                <span class="spinner-border spinner-border-sm" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                <span>{{ state.isSubmitting ? 'Please wait...' : 'Send reset link' }}</span>
            </button>
    </form>

    <div class="auth-links">
        <a asp-page="/Accounts/Login"><i class="fas fa-arrow-left mr-1"></i>Back to sign in</a>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Accounts/ForgotPassword.cshtml.js"></script>
}
