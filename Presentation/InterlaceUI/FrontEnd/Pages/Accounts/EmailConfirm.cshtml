@page
@{
    ViewData["Title"] = "Confirming your email";
}

<div id="app" v-cloak>
    <div class="auth-status">
        <div class="icon"><i class="fas fa-envelope-circle-check"></i></div>
        <h1 class="auth-title">Confirming your email</h1>
        <p class="auth-sub">Please wait while we confirm your email address.</p>
        <span class="spinner-border spinner-border-sm" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
    </div>
    <div class="auth-links" style="justify-content:center"><a asp-page="/Accounts/Login">Go to sign in</a></div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Accounts/EmailConfirm.cshtml.js"></script>
}
