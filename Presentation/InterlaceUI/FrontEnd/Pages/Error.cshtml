@page
@{
    Layout = "~/FrontEnd/Pages/Shared/AdminLTE/_Auth.cshtml";
    ViewData["Title"] = "Something went wrong";
}

<div class="auth-status">
    <div class="icon"><i class="fas fa-triangle-exclamation"></i></div>
    <h1 class="auth-title">Something went wrong</h1>
    <p class="auth-sub">The page could not be shown. Your data is safe. Try again, or go back to your dashboard.</p>
    <a class="auth-btn" style="text-decoration:none" href="/Dashboards/MyWork">Back to dashboard</a>
</div>
