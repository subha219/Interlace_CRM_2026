@page
@{
    ViewData["Title"] = "Support Categories";
}

<div id="app" v-cloak>
    <div class="alert alert-info small">Categories group support cases into queues. A category can have a default owner and priority; on the Support Cases list, "Category…" assigns a case and can route it to that owner.</div>
    <div class="card mb-3">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label small mb-0">Name</label><input class="form-control form-control-sm" maxlength="100" v-model="state.form.name" /></div>
            <div class="col-md-3"><label class="form-label small mb-0">Description</label><input class="form-control form-control-sm" maxlength="500" v-model="state.form.description" /></div>
            <div class="col-md-2"><label class="form-label small mb-0">Default owner</label>
                <select class="form-select form-select-sm" v-model="state.form.defaultOwnerUserId"><option :value="null">None</option><option v-for="u in state.users" :key="u.id" :value="u.id">{{ u.name }}</option></select></div>
            <div class="col-md-2"><label class="form-label small mb-0">Default priority</label>
                <select class="form-select form-select-sm" v-model="state.form.defaultPriority"><option :value="null">Keep</option><option v-for="p in priorities" :key="p">{{ p }}</option></select></div>
            <div class="col-md-2 d-flex gap-2 align-items-center">
                <div class="form-check"><input class="form-check-input" type="checkbox" id="act" v-model="state.form.isActive" /><label class="form-check-label small" for="act">Active</label></div>
                <button class="btn btn-sm btn-primary" @@click="save">{{ state.form.id ? 'Update' : 'Add' }}</button>
                <button class="btn btn-sm btn-light" v-if="state.form.id" @@click="reset">Cancel</button>
            </div>
        </div>
    </div>
    <div class="card"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Name</th><th>Description</th><th>Default owner</th><th>Priority</th><th>Active</th><th></th></tr></thead>
            <tbody>
                <tr v-if="!state.rows.length"><td colspan="6" class="text-muted">No categories yet.</td></tr>
                <tr v-for="c in state.rows" :key="c.id">
                    <td>{{ c.name }}</td><td class="text-muted">{{ c.description }}</td><td>{{ userName(c.defaultOwnerUserId) }}</td><td>{{ c.defaultPriority || '-' }}</td><td>{{ c.isActive ? 'Yes' : 'No' }}</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary" @@click="edit(c)">Edit</button> <button class="btn btn-sm btn-outline-danger" @@click="remove(c)">Delete</button></td>
                </tr>
            </tbody>
        </table>
    </div></div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/SupportSettings/Categories.cshtml.js"></script>
}
