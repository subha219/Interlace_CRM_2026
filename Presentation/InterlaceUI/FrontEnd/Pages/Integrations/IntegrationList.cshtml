@page
@{
    ViewData["Title"] = "Integrations";
}

<div id="app" v-cloak>
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item" v-for="t in tabs" :key="t.key"><a class="nav-link" :class="{ active: state.tab === t.key }" href="#" @@click.prevent="state.tab = t.key">{{ t.label }}</a></li>
    </ul>

    <!-- API keys -->
    <div v-if="state.tab === 'keys'">
        <div class="alert alert-info small">
            An API key lets a website form or another system create leads without a login. Send it in the <code>X-Api-Key</code> header. New leads are owned by whoever created the key.
            <pre class="mb-0 mt-2 small" style="white-space:pre-wrap">curl -X POST {{ origin }}/api/Public/CaptureLead -H "Content-Type: application/json" -H "X-Api-Key: YOUR_KEY" -d '{"name":"Jane Doe","email":"jane@example.com","phone":"+91 90000 00000","company":"Acme","message":"Please call me","source":"Website","consent":true}'</pre>
        </div>
        <div class="alert alert-success" v-if="state.newKey">
            <strong>Copy this key now. It is shown only once.</strong>
            <div class="d-flex gap-2 align-items-center mt-2"><code class="flex-grow-1" style="word-break:break-all">{{ state.newKey }}</code><button class="btn btn-sm btn-outline-secondary" @@click="copy(state.newKey)">Copy</button></div>
        </div>
        <div class="card mb-3">
            <div class="card-body d-flex flex-wrap gap-2 align-items-end">
                <div><label class="form-label">Name</label><input class="form-control form-control-sm" maxlength="100" v-model="state.keyName" placeholder="Website contact form" /></div>
                <div><label class="form-label">Expires in (days)</label><input type="number" min="1" class="form-control form-control-sm" style="width:130px" v-model.number="state.keyDays" placeholder="Never" /></div>
                <button class="btn btn-sm btn-primary" @@click="createKey" :disabled="!state.keyName">Create key</button>
            </div>
        </div>
        <div class="card"><div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Name</th><th>Key</th><th>Status</th><th>Last used</th><th>Expires</th><th></th></tr></thead>
                <tbody>
                    <tr v-if="!state.keys.length"><td colspan="6" class="text-muted">No keys yet.</td></tr>
                    <tr v-for="k in state.keys" :key="k.id">
                        <td>{{ k.name }}</td><td><code>{{ k.prefix }}...</code></td>
                        <td><span class="badge" :class="k.isActive ? 'bg-success' : 'bg-secondary'">{{ k.isActive ? 'Active' : 'Revoked' }}</span></td>
                        <td class="small">{{ when(k.lastUsedAtUtc) || 'Never' }}</td><td class="small">{{ when(k.expiresAtUtc) || '-' }}</td>
                        <td class="text-end"><button class="btn btn-sm btn-outline-danger" v-if="k.isActive" @@click="revoke(k)">Revoke</button></td>
                    </tr>
                </tbody>
            </table>
        </div></div>
    </div>

    <!-- Webhooks -->
    <div v-if="state.tab === 'hooks'">
        <div class="alert alert-info small">
            Webhooks send a signed JSON message to your address when something happens. Check the <code>X-Interlace-Signature</code> header: <code>sha256=</code> followed by the HMAC-SHA256 of the raw body using the signing secret. Failed deliveries retry up to 3 times. Addresses on private or local networks are blocked.
        </div>
        <div class="d-flex mb-2"><span class="flex-grow-1"></span><button class="btn btn-sm btn-primary" @@click="newHook">New webhook</button></div>
        <div class="card mb-3"><div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Name</th><th>Address</th><th>Events</th><th>Active</th><th></th></tr></thead>
                <tbody>
                    <tr v-if="!state.hooks.length"><td colspan="5" class="text-muted">No webhooks yet.</td></tr>
                    <tr v-for="h in state.hooks" :key="h.id">
                        <td>{{ h.name }}</td><td class="small" style="word-break:break-all">{{ h.url }}</td><td class="small">{{ h.events }}</td><td>{{ h.isActive ? 'Yes' : 'No' }}</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-primary" @@click="test(h)">Send test</button>
                            <button class="btn btn-sm btn-outline-secondary" @@click="editHook(h)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @@click="removeHook(h)">Delete</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div></div>
        <div class="card" v-if="state.form">
            <div class="card-header"><h6 class="mb-0">{{ state.form.id ? 'Edit webhook' : 'New webhook' }}</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Name</label><input class="form-control" maxlength="100" v-model="state.form.name" /></div>
                    <div class="col-md-8"><label class="form-label">Address (URL)</label><input class="form-control" maxlength="1000" v-model="state.form.url" placeholder="https://example.com/hooks/crm" /></div>
                    <div class="col-12"><label class="form-label">Events</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label v-for="e in state.events" :key="e"><input type="checkbox" :value="e" v-model="state.form.chosen" /> {{ e }}</label>
                        </div></div>
                    <div class="col-12" v-if="state.form.id">
                        <label class="form-label">Signing secret</label>
                        <div class="d-flex gap-2"><code class="flex-grow-1" style="word-break:break-all">{{ state.form.secret }}</code><button class="btn btn-sm btn-outline-secondary" @@click="copy(state.form.secret)">Copy</button></div>
                        <label class="mt-2"><input type="checkbox" v-model="state.form.rotateSecret" /> Generate a new secret when saving</label>
                    </div>
                    <div class="col-12"><label><input type="checkbox" v-model="state.form.isActive" /> Active</label></div>
                    <div class="col-12"><button class="btn btn-primary" @@click="saveHook">Save</button> <button class="btn btn-light" @@click="state.form = null">Cancel</button></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Deliveries -->
    <div v-if="state.tab === 'log'">
        <div class="d-flex mb-2"><span class="flex-grow-1 text-muted small">The last 100 deliveries.</span><button class="btn btn-sm btn-outline-primary" @@click="loadLog">Refresh</button></div>
        <div class="card"><div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>When</th><th>Webhook</th><th>Event</th><th>Result</th><th>Attempts</th><th>Detail</th></tr></thead>
                <tbody>
                    <tr v-if="!state.log.length"><td colspan="6" class="text-muted">Nothing delivered yet.</td></tr>
                    <tr v-for="d in state.log" :key="d.id">
                        <td class="small">{{ when(d.deliveredAtUtc) }}</td><td>{{ d.endpointName }}</td><td>{{ d.eventName }}</td>
                        <td><span class="badge" :class="d.success ? 'bg-success' : 'bg-danger'">{{ d.success ? 'Delivered' : 'Failed' }}</span> <span class="small text-muted" v-if="d.httpStatus">{{ d.httpStatus }}</span></td>
                        <td>{{ d.attempts }}</td><td class="small text-muted">{{ d.error }}</td>
                    </tr>
                </tbody>
            </table>
        </div></div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Integrations/IntegrationList.cshtml.js"></script>
}
