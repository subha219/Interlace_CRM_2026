@page
@{
    ViewData["Title"] = "Calendar Sync";
}

<div id="app" v-cloak>
    <div class="alert alert-info small">Your open tasks, calls and meetings that have a start time (from yesterday to 90 days ahead) appear in your Google or Outlook calendar (you connect one of them). Changes, completion and deletion in the CRM are copied over every 10 minutes. It is one-way: editing an event in the calendar does not change the CRM.</div>
    <div class="alert alert-success py-2" v-if="state.flash === 'connected'">Calendar connected.</div>
    <div class="alert alert-danger py-2" v-if="state.flash && state.flash !== 'connected'">{{ flashText }}</div>

    <div class="card" v-if="state.s">
        <div class="card-body">
            <div v-if="!state.s.configured && !state.s.outlookConfigured" class="alert alert-warning small mb-0">
                No calendar is set up yet. An administrator can add the Google client (or the Microsoft client for Outlook) under <strong>Settings &rarr; Connections</strong>.
                <div class="mt-2">Google redirect address: <code>{{ state.s.redirectUri }}</code></div>
                <div class="mt-1">Outlook redirect address: <code>{{ state.s.outlookRedirectUri }}</code> (the Microsoft app also needs the Calendars.ReadWrite permission)</div>
            </div>
            <template v-else>
                <div v-if="state.s.connected">
                    <p class="mb-1"><span class="badge bg-success">Connected</span> {{ state.s.provider === 'Outlook' ? 'Outlook' : 'Google' }} &middot; {{ state.s.email }}</p>
                    <p class="small text-muted mb-2" v-if="state.s.lastSyncUtc">Last sync {{ (state.s.lastSyncUtc || '').replace('T', ' ').substring(0, 16) }} UTC: {{ state.s.lastStatus }}</p>
                    <button class="btn btn-primary btn-sm" :disabled="state.busy" @@click="syncNow">Sync now</button>
                    <button class="btn btn-outline-danger btn-sm" @@click="disconnect">Disconnect</button>
                </div>
                <div v-else>
                    <p class="text-warning small" v-if="state.s.needsReconnect">The connection stopped working: {{ state.s.lastStatus }}</p>
                    <button class="btn btn-primary" v-if="state.s.configured" :disabled="state.busy" @@click="connect('google')">Connect Google Calendar</button>
                    <button class="btn btn-primary" v-if="state.s.outlookConfigured" :disabled="state.busy" @@click="connect('outlook')">Connect Outlook Calendar</button>
                </div>
            </template>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Profiles/GoogleCalendar.cshtml.js"></script>
}
