@page
@{
    ViewData["Title"] = "Message Templates";
}

<div id="app" v-cloak>
    <div class="alert alert-info py-2 small">
        WhatsApp templates must be approved by Meta first: enter the exact approved template name. SMS templates must be registered (DLT) and created as a flow in MSG91: enter its template id.
        List the variables in the order your template uses them, for example <code>name,amount</code>, and write the body with <code>{{ '{{name}}' }}</code> style placeholders.
    </div>
    <div class="d-flex mb-3"><span class="flex-grow-1"></span><button class="btn btn-sm btn-primary" @@click="add">New template</button></div>

    <div class="card mb-3" v-if="state.form"><div class="card-body"><div class="row g-2">
        <div class="col-md-4"><label class="form-label small mb-0">Name</label><input class="form-control form-control-sm" maxlength="100" v-model="state.form.name" /></div>
        <div class="col-md-2"><label class="form-label small mb-0">Channel</label><select class="form-select form-select-sm" v-model="state.form.channel"><option>WhatsApp</option><option>SMS</option></select></div>
        <div class="col-md-4"><label class="form-label small mb-0">{{ state.form.channel === 'SMS' ? 'MSG91 template id' : 'Approved template name' }}</label><input class="form-control form-control-sm" maxlength="200" v-model="state.form.providerTemplateId" /></div>
        <div class="col-md-2"><label class="form-label small mb-0">Language</label><input class="form-control form-control-sm" maxlength="20" placeholder="en" v-model="state.form.language" /></div>
        <div class="col-md-8"><label class="form-label small mb-0">Text</label><textarea class="form-control form-control-sm" rows="3" maxlength="2000" v-model="state.form.body"></textarea></div>
        <div class="col-md-4"><label class="form-label small mb-0">Variables (comma separated)</label><input class="form-control form-control-sm" maxlength="500" v-model="state.form.variables" />
            <div class="form-check mt-2"><input class="form-check-input" type="checkbox" id="act" v-model="state.form.isActive" /><label class="form-check-label small" for="act">Active</label></div></div>
    </div>
    <div class="mt-2"><button class="btn btn-sm btn-primary" @@click="save">Save</button> <button class="btn btn-sm btn-light" @@click="state.form = null">Cancel</button></div></div></div>

    <div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Name</th><th>Channel</th><th>Provider id</th><th>Variables</th><th>Active</th><th></th></tr></thead>
        <tbody>
            <tr v-if="!state.rows.length"><td colspan="6" class="text-muted">No templates yet.</td></tr>
            <tr v-for="t in state.rows" :key="t.id">
                <td>{{ t.name }}<div class="small text-muted">{{ t.body }}</div></td><td>{{ t.channel }}</td><td>{{ t.providerTemplateId }}</td><td>{{ t.variables }}</td>
                <td><span class="badge" :class="t.isActive ? 'bg-success' : 'bg-secondary'">{{ t.isActive ? 'Yes' : 'No' }}</span></td>
                <td class="text-end text-nowrap"><button class="btn btn-sm btn-outline-secondary" @@click="edit(t)">Edit</button> <button class="btn btn-sm btn-outline-danger" @@click="remove(t)">Delete</button></td>
            </tr>
        </tbody>
    </table></div></div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Messaging/Templates.cshtml.js"></script>
}
