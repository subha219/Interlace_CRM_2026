@page
@{
    ViewData["Title"] = "Knowledge Base";
}

<div id="app" v-cloak>
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <input class="form-control form-control-sm" style="max-width:280px" placeholder="Search articles..." v-model="state.q" @@keyup.enter="search" />
        <button class="btn btn-sm btn-outline-primary" @@click="search">Search</button>
        <span class="flex-grow-1"></span>
        <a class="small" href="/Accounts/HelpCenter" target="_blank">Public help centre</a>
        <button class="btn btn-sm btn-primary" @@click="add">New article</button>
    </div>

    <div class="card mb-3" v-if="state.form">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small mb-0">Title</label><input class="form-control form-control-sm" maxlength="200" v-model="state.form.title" /></div>
                <div class="col-md-3"><label class="form-label small mb-0">Category</label>
                    <select class="form-select form-select-sm" v-model="state.form.categoryId"><option :value="null">None</option><option v-for="c in state.categories" :key="c.id" :value="c.id">{{ c.name }}</option></select></div>
                <div class="col-md-3"><label class="form-label small mb-0">Tags</label><input class="form-control form-control-sm" maxlength="300" placeholder="comma separated" v-model="state.form.tags" /></div>
                <div class="col-12"><label class="form-label small mb-0">Short summary</label><input class="form-control form-control-sm" maxlength="500" v-model="state.form.summary" /></div>
                <div class="col-12"><label class="form-label small mb-0">Article text</label><textarea class="form-control" rows="10" maxlength="20000" v-model="state.form.body"></textarea></div>
            </div>
            <div class="d-flex gap-3 align-items-center mt-2">
                <div class="form-check"><input class="form-check-input" type="checkbox" id="pub" v-model="state.form.isPublished" /><label class="form-check-label" for="pub">Published on the public help centre</label></div>
                <button class="btn btn-sm btn-primary" @@click="save">Save</button>
                <button class="btn btn-sm btn-light" @@click="state.form = null">Cancel</button>
            </div>
        </div>
    </div>

    <div class="card"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Title</th><th>Category</th><th>Status</th><th>Views</th><th>Helpful</th><th></th></tr></thead>
            <tbody>
                <tr v-if="!state.rows.length"><td colspan="6" class="text-muted">No articles found.</td></tr>
                <tr v-for="a in state.rows" :key="a.id">
                    <td>{{ a.title }}<div class="small text-muted">{{ a.summary }}</div></td>
                    <td>{{ catName(a.categoryId) }}</td>
                    <td><span class="badge" :class="a.isPublished ? 'bg-success' : 'bg-secondary'">{{ a.isPublished ? 'Published' : 'Draft' }}</span></td>
                    <td>{{ a.viewCount }}</td><td>{{ a.helpfulYes }} yes / {{ a.helpfulNo }} no</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary" @@click="edit(a)">Edit</button> <button class="btn btn-sm btn-outline-danger" @@click="remove(a)">Delete</button></td>
                </tr>
            </tbody>
        </table>
    </div></div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/KnowledgeBase/ArticleList.cshtml.js"></script>
}
