@page
@{
    ViewData["Title"] = "Quotation Approvals";
}

<div id="app" v-cloak>
    <div class="card mb-3">
        <div class="card-header"><h6 class="mb-0">Approval policy</h6></div>
        <div class="card-body d-flex flex-wrap gap-2 align-items-end">
            <div><label class="form-label">A discount above this % needs approval</label>
                <input type="number" min="0" max="100" step="0.5" class="form-control form-control-sm" style="width:140px" v-model.number="state.threshold" /></div>
            <button class="btn btn-sm btn-primary" @@click="savePolicy">Save</button>
            <span class="small text-muted">Changing it affects discounts set from now on.</span>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center"><h6 class="mb-0 flex-grow-1">Waiting for a decision</h6><button class="btn btn-sm btn-outline-primary" @@click="load">Refresh</button></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Quotation</th><th>Customer</th><th class="text-end">Subtotal</th><th class="text-end">Discount</th><th class="text-end">Total (with tax)</th><th>Note</th><th style="min-width:260px">Decision</th></tr></thead>
                <tbody>
                    <tr v-if="!state.items.length"><td colspan="7" class="text-muted">Nothing is waiting for approval.</td></tr>
                    <tr v-for="q in state.items" :key="q.id">
                        <td>{{ q.number }}</td><td>{{ q.customer }}</td>
                        <td class="text-end">{{ money(q.subtotal) }}</td>
                        <td class="text-end">{{ q.discountPercent }}% <span class="small text-muted">({{ money(q.discountAmount) }})</span></td>
                        <td class="text-end">{{ money(q.total) }}</td>
                        <td class="small">{{ q.note }}</td>
                        <td>
                            <input class="form-control form-control-sm mb-1" placeholder="Note (required to reject)" v-model="state.notes[q.id]" />
                            <button class="btn btn-sm btn-success" @@click="decide(q, true)">Approve</button>
                            <button class="btn btn-sm btn-outline-danger" @@click="decide(q, false)">Reject</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/QuotationApprovals/ApprovalList.cshtml.js"></script>
}
