@page
@{
    ViewData["Title"] = "Activities & Calendar";
}

<style>
    .act-cal { display: grid; grid-template-columns: repeat(7, 1fr); border: 1px solid var(--border, #dee2e6); border-radius: 10px; overflow: hidden; }
    .act-cal .dow { padding: 8px; font-size: .75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted, #6c757d); background: var(--surface-2, #f8f9fa); text-align: center; }
    .act-cal .day { min-height: 104px; padding: 4px; border-top: 1px solid var(--border, #dee2e6); border-left: 1px solid var(--border, #dee2e6); cursor: pointer; background: var(--surface, #fff); }
    .act-cal .day:nth-child(7n + 8) { border-left: 0; }
    .act-cal .day.other { background: var(--surface-2, #f8f9fa); opacity: .65; }
    .act-cal .day.today .num { background: var(--primary, #0d6efd); color: #fff; }
    .act-cal .num { display: inline-block; min-width: 22px; height: 22px; line-height: 22px; text-align: center; border-radius: 11px; font-size: .78rem; }
    .act-chip { display: block; font-size: .72rem; padding: 1px 6px; margin-top: 2px; border-radius: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; }
    .act-chip.done { opacity: .5; text-decoration: line-through; }
    .t-Task { background: #4f46e5; } .t-Call { background: #0891b2; } .t-Meeting { background: #7c3aed; } .t-Email { background: #d97706; } .t-Note { background: #64748b; }
    .act-overdue { color: var(--danger, #dc3545); font-weight: 600; }
</style>

<div id="app" v-cloak>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="btn-group" role="group">
            <button class="btn btn-sm" :class="state.view === 'list' ? 'btn-primary' : 'btn-outline-primary'" @@click="state.view = 'list'">List</button>
            <button class="btn btn-sm" :class="state.view === 'calendar' ? 'btn-primary' : 'btn-outline-primary'" @@click="state.view = 'calendar'">Calendar</button>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select class="form-select form-select-sm" style="width:auto" v-model="state.scope" @@change="load">
                <option value="mine">My activities</option>
                <option value="all">Everyone</option>
            </select>
            <select class="form-select form-select-sm" style="width:auto" v-model="state.status">
                <option value="">Any status</option><option>Open</option><option>Done</option><option>Cancelled</option>
            </select>
            <select class="form-select form-select-sm" style="width:auto" v-model="state.type">
                <option value="">Any type</option><option v-for="t in types" :key="t">{{ t }}</option>
            </select>
            <button class="btn btn-sm btn-primary" @@click="openNew(null)">+ New activity</button>
        </div>
    </div>

    <div class="card" v-if="state.view === 'list'">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th style="width:44px"></th><th>Subject</th><th>Type</th><th>When</th><th>Related to</th><th>Assigned</th><th>Priority</th><th style="width:96px"></th></tr></thead>
                <tbody>
                    <tr v-if="!filtered.length"><td colspan="8" class="text-center text-muted py-4">Nothing here yet.</td></tr>
                    <tr v-for="a in filtered" :key="a.id">
                        <td><input type="checkbox" class="form-check-input" :checked="a.statusName === 'Done'" @@change="toggleDone(a)" :title="a.statusName === 'Done' ? 'Reopen' : 'Mark done'" /></td>
                        <td>
                            <div :style="a.statusName === 'Done' ? 'text-decoration:line-through;opacity:.6' : ''">{{ a.subject }}</div>
                            <div class="small text-muted" v-if="a.description">{{ a.description.substring(0, 90) }}</div>
                        </td>
                        <td><span class="badge" :class="'t-' + a.typeName">{{ a.typeName }}</span></td>
                        <td :class="{ 'act-overdue': a.isOverdue }">{{ fmt(a.startAt) }}<span v-if="a.endAt"> &rarr; {{ fmt(a.endAt) }}</span></td>
                        <td><a v-if="a.relatedType" :href="linkFor(a)">{{ a.relatedType }}: {{ a.relatedName }}</a></td>
                        <td>{{ assigneeName(a.assignedToUserId) }}</td>
                        <td>{{ a.priority }}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" @@click="openEdit(a)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @@click="remove(a)">&times;</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div v-else>
        <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="btn-group">
                <button class="btn btn-sm btn-outline-secondary" @@click="shift(-1)">&lsaquo;</button>
                <button class="btn btn-sm btn-outline-secondary" @@click="today">Today</button>
                <button class="btn btn-sm btn-outline-secondary" @@click="shift(1)">&rsaquo;</button>
            </div>
            <strong>{{ monthLabel }}</strong>
        </div>
        <div class="act-cal">
            <div class="dow" v-for="d in ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']" :key="d">{{ d }}</div>
            <div class="day" v-for="c in cells" :key="c.key" :class="{ other: !c.inMonth, today: c.isToday }" @@click="openNew(c.date)">
                <span class="num">{{ c.date.getDate() }}</span>
                <span class="act-chip" v-for="a in c.items.slice(0, 3)" :key="a.id" :class="['t-' + a.typeName, { done: a.statusName === 'Done' }]" @@click.stop="openEdit(a)" :title="a.subject">{{ timeOf(a) }}{{ a.subject }}</span>
                <span class="small text-muted" v-if="c.items.length > 3">+{{ c.items.length - 3 }} more</span>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="modalRef" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.form.id ? 'Edit activity' : 'New activity' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8"><label class="form-label">Subject</label><input class="form-control" v-model="state.form.subject" /></div>
                        <div class="col-md-4"><label class="form-label">Type</label>
                            <select class="form-select" v-model="state.form.type"><option v-for="t in types" :key="t">{{ t }}</option></select></div>
                        <div class="col-md-4"><label class="form-label">Starts / due</label><input type="datetime-local" class="form-control" v-model="state.form.startAt" /></div>
                        <div class="col-md-4"><label class="form-label">Ends</label><input type="datetime-local" class="form-control" v-model="state.form.endAt" /></div>
                        <div class="col-md-4"><label class="form-label">Priority</label>
                            <select class="form-select" v-model="state.form.priority"><option>Low</option><option>Normal</option><option>High</option></select></div>
                        <div class="col-md-4"><label class="form-label">Assigned to</label>
                            <select class="form-select" v-model="state.form.assignedToUserId"><option v-for="u in state.assignees" :key="u.id" :value="u.id">{{ u.name }}</option></select></div>
                        <div class="col-md-4"><label class="form-label">Related to</label>
                            <select class="form-select" v-model="state.form.relatedType" @@change="onRelatedType"><option value="">None</option><option value="Lead">Lead</option><option value="Customer">Customer</option><option value="SupportCase">Support case</option></select></div>
                        <div class="col-md-4" v-if="state.form.relatedType"><label class="form-label">Record</label>
                            <select class="form-select" v-model="state.form.relatedId" @@change="onRelatedPick"><option v-for="r in state.relatedOptions" :key="r.id" :value="r.id">{{ r.name }}</option></select></div>
                        <div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="3" v-model="state.form.description"></textarea></div>
                        <div class="col-12" v-if="state.form.id"><label class="form-label">Outcome</label><input class="form-control" v-model="state.form.outcome" placeholder="What happened?" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" @@click="save" :disabled="state.busy">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Activities/ActivityList.cshtml.js"></script>
}
